# Copy to .env; use distinct, randomly generated values. Never commit .env.
IWORK_DB_PASSWORD=
IWORK_MYSQL_ROOT_PASSWORD=
IWORK_HTTP_PORT=8080
IWORK_DATA_DIR=./data
# Required only before the first administrator is created; remove after first login.
IWORK_BOOTSTRAP_USERNAME=admin
IWORK_BOOTSTRAP_PASSWORD=
# Keep true for production HTTPS; false only for localhost HTTP development.
IWORK_COOKIE_SECURE=true
